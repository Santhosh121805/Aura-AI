# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# CoinMarketCap Pro API key
CMC_API_KEY=

# Comma-separated DefiLlama protocol slugs to track for RWA capital flow
RWA_PROTOCOL_SLUGS=ondo-finance
GEMINI_API_KEY=

# BOTChain Mainnet
BOT_CHAIN_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_CHAIN_ID=677
REGISTRY_CONTRACT_ADDRESS=0x2fcb4eDe5a608166A1d13b78ae18e435C63e68cC
# Set once AuraStrategyRegistryV2 is deployed and approved:
REGISTRY_CONTRACT_ADDRESS_V2=

# Legacy backend-signed auto-publish. Off by default — the supported way to
# publish a receipt is the connected-wallet flow in the frontend, which needs
# no server private key at all. Only set this to "true" for local/ops use.
ENABLE_LEGACY_AUTO_PUBLISH=false

# Required only if ENABLE_LEGACY_AUTO_PUBLISH=true. Never expose this value
# anywhere in frontend code or a VITE_ variable.
WALLET_PRIVATE_KEY=
