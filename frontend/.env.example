# All values here are public — this file is safe to commit.
# Never put a private key or seed phrase in a VITE_ variable: Vite inlines
# every VITE_ var into the client bundle at build time.

VITE_BOTCHAIN_CHAIN_ID=677
VITE_BOTCHAIN_RPC_URL=https://rpc.botchain.ai
VITE_BOTCHAIN_EXPLORER_URL=https://scan.botchain.ai

# AuraStrategyRegistryV2 — verified deployed on BOTChain Mainnet
VITE_REGISTRY_CONTRACT_ADDRESS=0x66266ec8FCE6190D507114C9EE91262eC887a9C4

# Real AURA AI backend (aura-ai/backend, FastAPI) — 6-agent pipeline + decision engine
VITE_API_URL=http://localhost:8002

# Reown (WalletConnect) Cloud project ID — get one at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=
